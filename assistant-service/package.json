{
  "name": "assistant-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private service that runs the in-app assistant agent. Local development only until deployment is approved.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run knowledge && tsx watch --env-file=.env.local src/main.ts",
    "start": "tsx --env-file=.env.local src/main.ts",
    "start:prod": "tsx src/main.ts",
    "knowledge": "node scripts/build-knowledge.mjs",
    "postinstall": "node scripts/link-shared-deps.mjs",
    "spike": "tsx --env-file=.env.local spike/spike.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cursor/sdk": "1.2.0",
    "@expo-google-fonts/cairo": "0.4.2",
    "@hono/node-server": "^2.1.5",
    "@supabase/supabase-js": "^2.99.3",
    "bidi-js": "1.1.0",
    "docx": "9.11.0",
    "exceljs": "4.4.0",
    "graphql": "^16.13.0",
    "hono": "^4.13.13",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "pdfkit": "0.20.2",
    "undici": "^7.16.0",
    "unpdf": "1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pdfkit": "0.17.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
